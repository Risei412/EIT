   "source": [
    "$B_z$ に対する余剰項の変化について"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 328,
   "id": "d2953bab",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 343,
   "id": "6c731919",
   "metadata": {},
   "outputs": [],
   "source": [
    "def Hamiltonian(Bx,By,Bz):\n",
    "    H_tot = np.array([[Bz, Bx-By*1j, 0 , -Bz*1j*0.05,0,0],\n",
    "              [Bx+By*1j,0, Bx-By*1j,0,-Bz*1j*0.05,0],\n",
    "              [0,Bx+By*1j,-Bz,0,0,-Bz*1j*0.05],\n",
    "              [Bz*1j*0.05,0,0,Bz,Bx-By*1j,0],\n",
    "              [0,Bz*1j*0.05,0,Bx+By*1j,0, Bx-By*1j],\n",
    "              [0,0,Bz*1j*0.05,0,Bx+By*1j,-Bz]])\n",
    "    \n",
    "    eig, eig_v = np.linalg.eig(H_tot)\n",
    "\n",
    "    return eig_v\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 344,
   "id": "b6866345",
   "metadata": {},
   "outputs": [],
   "source": [
    "def computation_for_tmp(Bx,By,Bz_list):\n",
    "    \n",
    "    tmp_list = []\n",
    "    B_perp = np.sqrt(Bx ** 2 + By ** 2)\n",
    "\n",
    "    for Bz in Bz_list:\n",
    "        eig_v = Hamiltonian(Bx,By,Bz)\n",
    "\n",
    "        eig_v_E_y =[eig_v[i][4] for i in range(6)] # |E_y>\n",
    "\n",
    "        a2 = eig_v_E_y[2]\n",
    "        a4 = eig_v_E_y[4]\n",
    "        a5 = eig_v_E_y[5]\n",
    "       \n",
    "\n",
    "        tmp_list.append(np.abs(-(Bx-1j*By)/Bz * a2 + 1j * a4) * np.abs(a2 + 1j * a5))\n",
    "\n",
    "    return tmp_list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 345,
   "id": "508b5415",
   "metadata": {},
   "outputs": [],
   "source": [
    "def computation_for_tmp_approx(Bx,By,Bz_list):\n",
    "    \n",
    "    tmp_list = []\n",
    "    B_perp = np.sqrt(Bx ** 2 + By ** 2)\n",
    "\n",
    "    for Bz in Bz_list:\n",
    "        eig_v = Hamiltonian(Bx,By,Bz)\n",
    "\n",
    "        eig_v_E_y =[eig_v[i][4] for i in range(6)] # |E_y>\n",
    "\n",
    "        a2 = eig_v_E_y[2]\n",
    "        a4 = eig_v_E_y[4]\n",
    "        a5 = eig_v_E_y[5]\n",
    "       \n",
    "\n",
    "        tmp_list.append(np.abs(1j * a4) * np.abs(a2 + 1j * a5))\n",
    "\n",
    "    return tmp_list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 351,
   "id": "28320586",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<matplotlib.legend.Legend at 0x23fab007850>"
      ]
     },
     "execution_count": 351,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
